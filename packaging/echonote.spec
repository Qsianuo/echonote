# -*- mode: python ; coding: utf-8 -*-
"""PyInstaller spec for the portable Windows build.

The hard part is not our own code, it is the native stack under it:
ctranslate2 (inference), onnxruntime (VAD) and av (audio) all ship DLLs that
PyInstaller cannot discover from imports alone. ``collect_all`` walks each
package and pulls data files, binaries and hidden imports together.

Build:  .venv\\Scripts\\pyinstaller packaging\\echonote.spec --noconfirm
Output: dist\\EchoNote\\EchoNote.exe   (one-dir; one-file would unpack ~300 MB
        to %TEMP% on every launch and make startup feel broken)
"""

from pathlib import Path

from PyInstaller.utils.hooks import collect_all, copy_metadata

ROOT = Path(SPECPATH).parent  # noqa: F821 - injected by PyInstaller

datas = [(str(ROOT / "web"), "web")]
binaries = []
hiddenimports = []

# Native stack: DLLs + data (e.g. faster_whisper/assets/silero_vad_v6.onnx).
# sentencepiece 是离线翻译的分词器（app/translate.py 在函数内 import，
# 静态分析能看到，但它的 .pyd 仍建议走 collect_all，避免运行时才报缺模块）。
for package in (
    "faster_whisper",
    "ctranslate2",
    "onnxruntime",
    "tokenizers",
    "av",
    "huggingface_hub",
    "sentencepiece",
):
    pkg_datas, pkg_binaries, pkg_hidden = collect_all(package)
    datas += pkg_datas
    binaries += pkg_binaries
    hiddenimports += pkg_hidden

# Version lookups at import time (importlib.metadata) need the wheel metadata.
for dist in (
    "faster-whisper",
    "ctranslate2",
    "onnxruntime",
    "tokenizers",
    "huggingface_hub",
    "av",
    "sentencepiece",
):
    datas += copy_metadata(dist)

# uvicorn resolves its loop/protocol implementations by string at runtime.
hiddenimports += [
    "uvicorn.logging",
    "uvicorn.loops",
    "uvicorn.loops.auto",
    "uvicorn.protocols",
    "uvicorn.protocols.http",
    "uvicorn.protocols.http.auto",
    "uvicorn.protocols.http.h11_impl",
    "uvicorn.protocols.websockets",
    "uvicorn.protocols.websockets.auto",
    "uvicorn.protocols.websockets.websockets_impl",
    "uvicorn.lifespan",
    "uvicorn.lifespan.on",
    "websockets.legacy",
    "websockets.legacy.server",
    "app.desktop",
    # Imported lazily from desktop._fetch_model, so PyInstaller's static
    # analysis cannot see it.
    "app.fetch",
    "app.models",
]

excludes = [
    "tkinter",
    "matplotlib",
    "pandas",
    "scipy",
    "torch",
    "transformers",
    "IPython",
    "pytest",
    "PyInstaller",
    "setuptools",
    "pip",
]

a = Analysis(  # noqa: F821
    [str(ROOT / "packaging" / "launch.py")],
    pathex=[str(ROOT)],
    binaries=binaries,
    datas=datas,
    hiddenimports=hiddenimports,
    hookspath=[],
    runtime_hooks=[],
    excludes=excludes,
    noarchive=False,
)

pyz = PYZ(a.pure)  # noqa: F821

exe = EXE(  # noqa: F821
    pyz,
    a.scripts,
    [],
    exclude_binaries=True,
    name="EchoNote",
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=False,
    # Kept as a console binary on purpose. A windowed build has sys.stdout set
    # to None, which would silently break `--self-test` output capture in CI and
    # the download progress that fetch-model.bat shows. Instead the process
    # hides its own console window at startup unless it was launched from a
    # shell — see app.desktop._hide_own_console.
    console=True,
    disable_windowed_traceback=False,
    # Generated by packaging/make_icon.py; embedded so the taskbar and the
    # Explorer entry stop showing the generic PyInstaller icon.
    icon=str(ROOT / "packaging" / "echonote.ico"),
)

coll = COLLECT(  # noqa: F821
    exe,
    a.binaries,
    a.datas,
    strip=False,
    upx=False,
    name="EchoNote",
)
